<?xml version="1.0" encoding="UTF-8"?>
<!-- What `gradlew jooqCodegen` (make jooq) generates. Reads the LOCAL database, port from CLAUDE.md. -->
<configuration xmlns="http://www.jooq.org/xsd/jooq-codegen-3.21.0.xsd">
  <jdbc>
    <driver>org.postgresql.Driver</driver>
    <url>jdbc:postgresql://localhost:20000/hangelo</url>
    <user>hangelo</user>
    <password>hangelo</password>
  </jdbc>
  <generator>
    <database>
      <name>org.jooq.meta.postgres.PostgresDatabase</name>
      <inputSchema>public</inputSchema>
      <excludes>flyway_schema_history</excludes>
      <forcedTypes>
        <!-- Moments are java.time.Instant everywhere, as in the entities. -->
        <forcedType>
          <name>INSTANT</name>
          <includeTypes>(?i:timestamp\ with\ time\ zone|timestamptz)</includeTypes>
        </forcedType>
        <!-- Text columns with a closed set of values are read as the enums of lib:model.
             A new enum column gets a new entry here. -->
        <forcedType>
          <userType>kz.nuraskhan.hangelo.model.enums.FriendshipStatus</userType>
          <enumConverter>true</enumConverter>
          <includeExpression>public\.friendship\.status</includeExpression>
        </forcedType>
        <forcedType>
          <userType>kz.nuraskhan.hangelo.model.enums.EventType</userType>
          <enumConverter>true</enumConverter>
          <includeExpression>public\.event\.event_type|public\.place\.category</includeExpression>
        </forcedType>
        <forcedType>
          <userType>kz.nuraskhan.hangelo.model.enums.EventStatus</userType>
          <enumConverter>true</enumConverter>
          <includeExpression>public\.event\.status</includeExpression>
        </forcedType>
        <forcedType>
          <userType>kz.nuraskhan.hangelo.model.enums.InvitationStatus</userType>
          <enumConverter>true</enumConverter>
          <includeExpression>public\.invitation\.status</includeExpression>
        </forcedType>
        <forcedType>
          <userType>kz.nuraskhan.hangelo.model.enums.EventVisibility</userType>
          <enumConverter>true</enumConverter>
          <includeExpression>public\.event\.visibility</includeExpression>
        </forcedType>
        <forcedType>
          <userType>kz.nuraskhan.hangelo.model.enums.NotificationKind</userType>
          <enumConverter>true</enumConverter>
          <includeExpression>public\.notification\.kind</includeExpression>
        </forcedType>
        <forcedType>
          <userType>kz.nuraskhan.hangelo.model.enums.AvailabilityKind</userType>
          <enumConverter>true</enumConverter>
          <includeExpression>public\.availability\.kind</includeExpression>
        </forcedType>
        <forcedType>
          <userType>kz.nuraskhan.hangelo.model.enums.Privilege</userType>
          <enumConverter>true</enumConverter>
          <includeExpression>public\.profile\.privilege</includeExpression>
        </forcedType>
      </forcedTypes>
    </database>
    <generate>
      <!-- Joins are written explicitly. The implicit paths also clash by name here: user_account
           is referenced by several columns of one table. -->
      <implicitJoinPathsToOne>false</implicitJoinPathsToOne>
      <implicitJoinPathsToMany>false</implicitJoinPathsToMany>
      <implicitJoinPathsManyToMany>false</implicitJoinPathsManyToMany>
    </generate>
    <target>
      <packageName>kz.nuraskhan.hangelo.jooq</packageName>
      <directory>src/main/java</directory>
    </target>
  </generator>
</configuration>
