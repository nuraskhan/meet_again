release: java -cp "build/stage/migration/*" kz.nuraskhan.hangelo.migration.Migrate "$JDBC_DATABASE_URL" "$JDBC_DATABASE_USERNAME" "$JDBC_DATABASE_PASSWORD" && if [ -n "$HANGELO_2GIS_KEY" ]; then HANGELO_IMPORT_ONLY_IF_EMPTY=1 HANGELO_IMPORT_DB_URL="$JDBC_DATABASE_URL" HANGELO_IMPORT_DB_USER="$JDBC_DATABASE_USERNAME" HANGELO_IMPORT_DB_PASSWORD="$JDBC_DATABASE_PASSWORD" java -cp "build/stage/place-import/*" kz.nuraskhan.hangelo.placeimport.PlaceImport || echo "The venue import failed; the release goes on without it"; fi
web: HANGELO_DB_URL="$JDBC_DATABASE_URL" HANGELO_DB_USER="$JDBC_DATABASE_USERNAME" HANGELO_DB_PASSWORD="$JDBC_DATABASE_PASSWORD" java $JAVA_OPTS -Dserver.port=$PORT -jar build/stage/hangelo.jar
